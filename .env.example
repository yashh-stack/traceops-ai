# TraceOps AI Environment Variables
# Google DeepMind x Cloud Startup Buildathon India 2026

# Deployment Environment: "development" | "staging" | "production"
# Note: In "production", admin routes (/v1/mode, /v1/reset, /v1/spans) fail closed if TRACEOPS_ADMIN_TOKEN is unset.
TRACEOPS_ENV=development

# Execution Mode: "enforce" (actively halts rogue steps) or "shadow" (logs violations & computes savings)
TRACEOPS_MODE=enforce

# Tier-1 Deterministic Guard Thresholds
MAX_IDENTICAL_CALLS=3
MAX_COST_USD=0.50
MAX_TOKENS=25000

# Tier-2 Semantic Drift Thresholds
DRIFT_THRESHOLD=0.55
WARN_THRESHOLD=0.40

# Tier-3 Async OTel & Fail-Safe Configuration
OTEL_NOMINAL_SAMPLE_RATE=0.10
OTEL_RING_BUFFER_MAXLEN=500
FAIL_OPEN_TIER3=true

# Security & Admin Controls (set strong random token in production!)
TRACEOPS_ADMIN_TOKEN=change_me_in_production
CORS_ORIGINS=["http://localhost:8501","http://127.0.0.1:8501","https://traceops-ai.streamlit.app"]
MAX_REQUEST_BYTES=65536
RATE_LIMIT_RPM=600

# Google Gemini API Configuration (Async Judge & Offline Baseline Builder)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_JUDGE_MODEL=gemini-3.5-flash-lite
GEMINI_BASELINE_MODEL=gemini-3.8-flash

# Cloud SQL / PostgreSQL + pgvector (Optional, in-memory fallback enabled by default)
DATABASE_URL=postgresql://traceops_user:password@127.0.0.1:5432/traceops_db

# Google Cloud Project Configuration
GCP_PROJECT_ID=builder-cup-511710
GCP_REGION=asia-south1
PORT=8080
